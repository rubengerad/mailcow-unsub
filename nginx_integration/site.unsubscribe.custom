# Drop this file into data/conf/nginx/ on the mailcow host (that directory is
# itself bind-mounted to /etc/nginx/conf.d/ inside the nginx-mailcow
# container -- there is no separate conf.d/ subfolder to create) as
# site.unsubscribe.custom (any name matching site.*.custom works -- mailcow's
# generated sites-default.conf includes that glob, and it is NOT overwritten
# by update.sh/generate_config.sh).
#
# Exposes the one-click unsubscribe HTTP endpoint (app/webapp.py) under the
# mailcow GUI/webmail domain's existing TLS, proxied to the mailcow-unsub
# container over the shared mailcow-network. Adjust the proxy_pass port if
# you changed ONE_CLICK_HTTP_PORT.

location /unsubscribe {
    proxy_pass http://mailcow-unsub:8080/unsubscribe;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
