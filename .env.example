# ── Zero-config path (recommended) ──────────────────────────────────────
# Mount your mailcow-dockerized checkout's mailcow.conf read-only into this
# container (see the volumes: section in docker-compose.yml) and leave
# MYSQL_*, IMAP_HOST and MAILCOW_API_URL/KEY below UNSET. On startup
# app/bootstrap.py will:
#   - derive MYSQL_HOST/MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE and
#     IMAP_HOST/MAILCOW_API_URL from mailcow.conf's DBUSER/DBPASS/DBNAME/
#     MAILCOW_HOSTNAME,
#   - apply postfix_integration/schema.sql automatically,
#   - self-provision a mailcow API key by inserting it directly into
#     mailcow's own `api` table (reuses an existing read-write key if one's
#     already there instead of making a duplicate),
#   - default to MULTI_DOMAIN_ENABLED=true (auto-discovering every mailcow
#     domain and creating/polling unsubscribe@<domain> for each) if you
#     haven't set IMAP_USER or MULTI_DOMAIN_ENABLED yourself,
#   - generate and persist UNSUB_MAILBOX_PASSWORD / ONE_CLICK_TOKEN_SECRET
#     the first time they're needed, so you never have to invent or store
#     them yourself.
# Any value you DO set below is left untouched -- bootstrap only fills in
# what's missing. See "Zero-config setup" in README.md.
MAILCOW_CONF_PATH=/mailcow.conf

# ── IMAP polling ─────────────────────────────────────────────────────────
# Leave IMAP_HOST unset to use the mailcow.conf-derived value above.
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
POLL_INTERVAL_SECONDS=60

# Single-mailbox mode: poll exactly one unsubscribe mailbox. Set BOTH of
# these (e.g. IMAP_USER=unsubscribe@example.com) to opt out of multi-domain
# auto-discovery and pin to one fixed mailbox instead.
IMAP_USER=
IMAP_PASSWORD=

# Multi-domain mode: instead of a single fixed mailbox, discover every
# domain hosted on this mailcow instance (via its Admin API) and poll
# UNSUB_LOCAL_PART@<domain> for EACH of them, auto-creating that mailbox if
# it doesn't already exist -- so any domain you add in mailcow's admin GUI
# automatically gets its own unsubscribe@<domain> catch address with no
# manual setup. Mutually exclusive with single-mailbox IMAP_USER above.
# Left blank here on purpose: app/bootstrap.py defaults this to true
# whenever IMAP_USER is also left unset, which is the case below.
MULTI_DOMAIN_ENABLED=
UNSUB_LOCAL_PART=unsubscribe
# Shared password mailcow-unsub sets when it creates each domain's
# unsubscribe@ mailbox. Leave unset to have bootstrap.py generate and
# persist one for you. If a domain already had a manually-created
# unsubscribe@ mailbox with a different password, IMAP login for that one
# domain will fail (logged, skipped) until its password is reset to match.
UNSUB_MAILBOX_PASSWORD=
# How often (seconds) to re-query mailcow's domain list for newly added
# domains and re-check/provision their unsubscribe@ mailbox.
DOMAIN_DISCOVERY_INTERVAL_SECONDS=300

# ── MySQL connection to mailcow's own database ──────────────────────────
# (so the Postfix check_recipient_access map can query the same table with
# no extra hop). Leave all four unset to derive from mailcow.conf above.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── mailcow Admin API ────────────────────────────────────────────────────
# Leave MAILCOW_API_URL/MAILCOW_API_KEY unset to derive/self-provision them
# via mailcow.conf + direct DB insert (see top of file). Set MAILCOW_API_KEY
# yourself instead if you'd rather generate one via mailcow's GUI
# (Configuration > Access > API) than rely on that undocumented mechanism.
# If mailcow.conf isn't mounted (MAILCOW_API_URL must be set manually), point
# it at mailcow's nginx container directly over the shared docker network
# (e.g. http://nginx-mailcow, no TLS) rather than mailcow's public hostname --
# the public hostname may be fronted by a reverse proxy (Traefik, Dokploy,
# etc.) that doesn't route general HTTPS traffic for it, only specific
# subdomains/paths, which otherwise surfaces as a confusing TLS/cert error or
# 404 from the *proxy* rather than a clear error from mailcow itself.
MAILCOW_API_URL=
# Leaving this blank is usually the right call even if you have an API_KEY
# value sitting in mailcow's own .env/environment: that value isn't
# necessarily a real key already inserted into mailcow's `api` DB table
# (depends on how/when that mailcow instance was provisioned) and using an
# invalid one fails with a 401 that looks identical to a real auth failure.
# Bootstrap's self-provisioning (see top of file) checks the DB directly, so
# it reuses a real existing key if there is one or mints a working one if not.
MAILCOW_API_KEY=
MAILCOW_MAILBOX_NAME=Unsubscribe Requests
MAILCOW_MAILBOX_QUOTA_MB=1024
# Single-mailbox mode only: auto-create the IMAP_USER mailbox above via the
# Admin API on startup if it doesn't exist yet. Ignored in multi-domain mode
# (which always auto-provisions per-domain).
MAILCOW_AUTO_PROVISION=true

# ── Sender bounce notifications (on by default) ─────────────────────────
# Notify the ORIGINAL SENDER by email when Postfix rejects their mail
# because the recipient unsubscribed. Only fires for SASL-authenticated
# senders (i.e. real mailcow-hosted users/apps) -- never for arbitrary
# inbound From: addresses, since those are spoofable and would otherwise
# turn this into a backscatter-spam vector. REQUIRES mounting
# /var/run/docker.sock into this container (uncommented by default in
# docker-compose.yml) so it can tail postfix-mailcow's logs for the reject
# event -- that grants the container read access to the Docker API, which
# is effectively root-equivalent on the host. Set BOUNCE_NOTIFY_ENABLED=false
# and remove that mount if you're not comfortable with that trade-off.
BOUNCE_NOTIFY_ENABLED=true
POSTFIX_CONTAINER_NAME=postfix-mailcow
BOUNCE_NOTIFY_COOLDOWN_HOURS=24
# Defaults to IMAP_HOST / port 587 (STARTTLS submission), authenticating as
# IMAP_USER/IMAP_PASSWORD -- override only if that mailbox shouldn't be the
# notification sender.
BOUNCE_SMTP_HOST=
BOUNCE_SMTP_PORT=587
BOUNCE_FROM_NAME=Mail Delivery (Unsubscribe Notice)

# ── One-click unsubscribe (on by default, RFC 8058) ─────────────────────
# Runs a tiny HTTP server (app/webapp.py) with a GET (browser click, e.g.
# from the mailto fallback's landing page) and POST (native "Unsubscribe"
# button in Gmail/Outlook/Yahoo, called automatically with no user
# confirmation) endpoint that suppresses a signed-token email address. Not
# reachable from outside the mailcow-network by itself even when enabled --
# see nginx_integration/site.unsubscribe.custom to actually expose it
# publicly under mailcow's own domain/TLS (a manual step, not automated).
#
# Whatever composes your outbound mail (e.g. zipbook) should import
# app/list_unsubscribe_header.py (stdlib-only, safe to vendor) using the same
# ONE_CLICK_BASE_URL/ONE_CLICK_TOKEN_SECRET to build matching headers.
ONE_CLICK_ENABLED=true
ONE_CLICK_HTTP_PORT=8080
# Leave unset to have bootstrap.py generate and persist one for you.
ONE_CLICK_TOKEN_SECRET=
# Public URL that nginx proxies to this container's /unsubscribe endpoint
# (see nginx_integration/site.unsubscribe.custom). Used only by
# list_unsubscribe_header.py when building the List-Unsubscribe header.
ONE_CLICK_BASE_URL=https://mail.example.com/unsubscribe
